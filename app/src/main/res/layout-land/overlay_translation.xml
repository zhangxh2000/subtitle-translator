<?xml version="1.0" encoding="utf-8"?><!--
  翻译结果覆盖层（横屏 · 编辑纸感：无卡片、发丝分隔线、字幕块垂直居中）

  设计要点：
  1. 不再使用白色卡片分层，所有内容直接排在暖纸画布上，靠字号层级和 1dp 分隔线组织；
  2. 左侧字幕块在双栏行内垂直居中，与右侧词表等高呼应，不会在左下留出一大块空洞；
  3. 顶部工具栏收敛为「AI 胶囊 + 幽灵图标」：上一句/下一句放到顶部，
     底部只留 48dp 收起条，纵向空间全部让给内容；
  4. 右侧生词区独立滚动，字幕始终固定在左侧。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_translation_overlay"
    android:paddingStart="@dimen/overlay_padding_horizontal"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/overlay_padding_horizontal"
    android:paddingBottom="4dp">

    <!-- 顶部工具栏：左侧 AI 翻译纠错胶囊，右侧整句收藏 + 上一句/下一句 + 关闭（幽灵图标） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- AI 精译：纸感描边胶囊，请求中图标旋转，完成后高亮 -->
        <LinearLayout
            android:id="@+id/btnAiTranslate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_ai_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:contentDescription="@string/overlay_ai_translate">

            <ImageView
                android:id="@+id/ivAiTranslateIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ai_translate" />

            <TextView
                android:id="@+id/tvAiTranslateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/overlay_ai_translate"
                android:textColor="@color/overlay_ai_pill_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 整句收藏 -->
        <ImageButton
            android:id="@+id/btnSaveSentence"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_save_sentence"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bookmark_border"
            android:tint="@color/text_secondary"
            android:visibility="gone" />

        <!-- 上一句 -->
        <ImageButton
            android:id="@+id/btnPreviousSubtitle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/overlay_previous_subtitle" />

        <!-- 下一句 -->
        <ImageButton
            android:id="@+id/btnNextSubtitle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/overlay_next_subtitle" />

        <!-- 关闭：用主文字色收尾，与翻页区分层级 -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="4dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="@color/text_primary"
            android:contentDescription="@string/action_close" />
    </LinearLayout>

    <!--
      中间双栏（0dp + weight=1）：
      左栏字幕块用 layout_gravity=center_vertical 在行内垂直居中，高度只包住双语文本；
      右栏「重点词汇」标题 + 独立滚动词条列表。
    -->
    <LinearLayout
        android:id="@+id/overlayBodyRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- 左栏（44%）：无卡片字幕块，靠竖饰条与字号区分层级 -->
        <LinearLayout
            android:id="@+id/subtitleHeroCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.44"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="2.5dp"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/bg_subtitle_accent_bar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="18dp"
                android:orientation="vertical">

                <!-- 译文：第一视觉焦点 -->
                <TextView
                    android:id="@+id/tvTranslatedText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="balanced"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:lineSpacingMultiplier="1.28" />

                <!-- 原文：紧随译文下方 -->
                <TextView
                    android:id="@+id/tvOriginalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右栏（56%）：重点词汇标题 + 独立滚动词条列表 -->
        <LinearLayout
            android:id="@+id/wordsColumn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.56"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- 重点词汇标题行：标题 + 词数，与词条左内边距对齐 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/word_card_padding"
                android:paddingEnd="@dimen/word_card_padding"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/overlay_key_words"
                    android:textAppearance="@style/TextAppearance.SubtitleTranslator.SectionLabel" />

                <TextView
                    android:id="@+id/tvWordCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SubtitleTranslator.Caption"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 滚动区 + 底部渐隐：内容被视口截断时给出「还能滑」的视觉提示 -->
            <FrameLayout
                android:id="@+id/wordsScrollFrame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ScrollView
                    android:id="@+id/contentScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/wordsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="@dimen/overlay_scroll_fade_height"
                        android:orientation="vertical" />
                </ScrollView>

                <View
                    android:id="@+id/scrollFade"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/overlay_scroll_fade_height"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_scroll_fade"
                    android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部收起条：48dp 触摸区内居中显示轻提示 -->
    <LinearLayout
        android:id="@+id/btnCollapse"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_target"
        android:gravity="center"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand_less"
            android:tint="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/overlay_collapse_hint"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
