<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/word_card_padding"
    android:paddingTop="@dimen/word_card_padding"
    android:paddingEnd="@dimen/word_card_padding_end"
    android:paddingBottom="@dimen/word_card_padding"
    android:layout_marginTop="@dimen/word_card_spacing"
    android:background="@drawable/bg_card">

    <!--
      难度标签：要与单词行中心对齐。
      单词行被 40dp 的朗读/收藏按钮撑高，标签高 24dp，
      所以下移 (40-24)/2 = 8dp —— 改按钮高度时这个值要跟着改。
      标签形状固定，颜色在运行时按难度用 backgroundTintList 上色。
    -->
    <TextView
        android:id="@+id/tvDifficulty"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:minWidth="32dp"
        android:paddingHorizontal="8dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/difficulty_medium_text"
        android:background="@drawable/bg_difficulty_tag" />

    <!-- 单词信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <!--
          必须关闭 baseline 对齐：水平 LinearLayout 默认按文字基线排列，
          这行里塞进 40dp 的图标按钮后，单词会被贴到行顶部而不是垂直居中，
          gravity="center_vertical" 形同虚设，右侧难度标签也就对不上了。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <!--
              文本区必须可压缩：竖屏窄屏上「长单词 + 音标 + 两个 40dp 按钮」会超宽，
              旧写法用 wrap_content 会把按钮推到卡片外。现在文本区吃剩余宽度，
              单词优先显示，音标放不下时省略，按钮永远留在屏幕内。
            -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextView
                    android:id="@+id/tvWord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.SubtitleTranslator.Word" />

                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAppearance="@style/TextAppearance.SubtitleTranslator.Phonetic" />
            </LinearLayout>

            <!--
              40dp 点击区 + 8dp padding = 24dp 图标；
              两个按钮的 8dp padding 叠在一起就是 16dp 的图标间距，
              不再额外加 margin，避免图标之间看起来过空。
            -->
            <ImageButton
                android:id="@+id/btnPronounce"
                android:layout_width="@dimen/word_icon_size"
                android:layout_height="@dimen/word_icon_size"
                android:padding="@dimen/word_icon_padding"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_volume_up"
                android:contentDescription="@string/action_pronounce" />

            <ImageButton
                android:id="@+id/btnSaveWord"
                android:layout_width="@dimen/word_icon_size"
                android:layout_height="@dimen/word_icon_size"
                android:padding="@dimen/word_icon_padding"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_bookmark_border"
                android:contentDescription="@string/action_save_word" />
        </LinearLayout>

        <!-- 补回卡片右侧少掉的 8dp，让释义文字的视觉右留白仍与左侧一致 -->
        <TextView
            android:id="@+id/tvMeanings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="@dimen/word_icon_padding"
            android:textAppearance="@style/TextAppearance.SubtitleTranslator.Meaning" />
    </LinearLayout>

</LinearLayout>
