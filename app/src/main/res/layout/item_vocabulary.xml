<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/word_card_padding"
    android:layout_marginTop="@dimen/word_card_spacing"
    android:background="@drawable/bg_card">

    <!-- 与 item_word_entry 相同的对齐约定：单词行被 40dp 按钮撑高，标签下移 (40-24)/2 = 8dp -->
    <TextView
        android:id="@+id/tvDifficulty"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="8dp"
        android:minWidth="32dp"
        android:paddingHorizontal="8dp"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/difficulty_medium_text"
        android:background="@drawable/bg_difficulty_tag" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tvWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.Word" />

            <TextView
                android:id="@+id/tvPhonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.Phonetic" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnPronounce"
                android:layout_width="@dimen/word_icon_size"
                android:layout_height="@dimen/word_icon_size"
                android:padding="@dimen/word_icon_padding"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_volume_up"
                android:contentDescription="@string/action_pronounce" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="@dimen/word_icon_size"
                android:layout_height="@dimen/word_icon_size"
                android:padding="@dimen/word_icon_padding"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:contentDescription="@string/action_delete" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMeanings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.SubtitleTranslator.Meaning" />

        <TextView
            android:id="@+id/tvAddedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
