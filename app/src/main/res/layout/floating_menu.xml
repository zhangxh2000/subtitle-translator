<?xml version="1.0" encoding="utf-8"?><!--
  长按悬浮球弹出的快捷菜单

  使用与翻译覆盖层一致的深色圆角背景，保持视觉统一。
  菜单项用 TextView + selectableItemBackground，比 Button 更紧凑，也更符合「菜单」的观感。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:minWidth="160dp"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/menuHistory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="翻译历史"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/menuSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="设置"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- 仅在设置里打开了「保存识别过程截图」时显示，方便调试时快速查看 -->
    <TextView
        android:id="@+id/menuDebugCapture"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="识别截图"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="@color/divider" />

    <TextView
        android:id="@+id/menuStop"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="停止字幕翻译"
        android:textColor="@color/difficulty_hard_text"
        android:textSize="15sp" />

</LinearLayout>
