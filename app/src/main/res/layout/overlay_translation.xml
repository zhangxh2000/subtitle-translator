<?xml version="1.0" encoding="utf-8"?><!--
  翻译结果覆盖层

  层级：标题栏 → 译文（视觉焦点）→ 原文对照（次级）→ 重点词汇 → 收起提示。
  标题栏和底部收起提示固定，中间内容放在 ScrollView 里：单词释义多时整个面板会很高，
  必须能滚动查看；而关闭按钮不能跟着内容滚走，否则用户没法关掉面板。
  悬浮窗高度由 TranslationOverlayView.windowHeightFor() 按屏幕高度封顶。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_translation_overlay"
    android:paddingHorizontal="@dimen/overlay_padding_horizontal"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- 标题栏（固定）：标题 + 副标题 / 圆形关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/overlay_title"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.ScreenTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/overlay_subtitle"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.Overline" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_icon_button"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/action_close" />
    </LinearLayout>

    <!-- 标题区与内容区的分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 译文：第一视觉焦点 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/overlay_translated_label"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.SectionLabel" />

            <TextView
                android:id="@+id/tvTranslatedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.Translation" />

            <!-- 原文对照：次级信息 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/overlay_original_label"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.SectionLabel" />

            <TextView
                android:id="@+id/tvOriginalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.35" />

            <!-- 字幕区与单词区的分隔线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/divider" />

            <!-- 重点词汇标题行：标题 + 词数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/overlay_key_words"
                    android:textAppearance="@style/TextAppearance.SubtitleTranslator.SectionLabel" />

                <TextView
                    android:id="@+id/tvWordCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SubtitleTranslator.Caption"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <!-- 底部收起提示（固定）：与右上角关闭按钮等效 -->
    <TextView
        android:id="@+id/btnCollapse"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_expand_less"
        android:drawablePadding="4dp"
        android:text="@string/overlay_collapse_hint"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

</LinearLayout>
