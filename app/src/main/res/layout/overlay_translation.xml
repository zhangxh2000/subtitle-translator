<?xml version="1.0" encoding="utf-8"?><!--
  翻译结果覆盖层（竖屏：柔和云灰底画布 + 固定纯白字幕卡片 + 独立滚动生词区）

  核心设计：
  1. 字幕双语主卡片固定在 ScrollView 之外（Sticky Hero）：往下滑看生词时，
     原句与译文始终留在顶部对照，不会滚丢，词卡也不会被顶部按钮生硬腰斩。
  2. ScrollView 只承载「重点词汇」列表，按屏幕高度封顶时独立滚动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_translation_overlay"
    android:paddingHorizontal="@dimen/overlay_padding_horizontal"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 顶部工具栏（固定）：左侧 AI 翻译纠错胶囊，右侧整句收藏 + 关闭 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- AI 精译：左侧品牌微描边胶囊，请求中图标旋转，完成后高亮 -->
        <LinearLayout
            android:id="@+id/btnAiTranslate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_ai_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:contentDescription="@string/overlay_ai_translate">

            <ImageView
                android:id="@+id/ivAiTranslateIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ai_translate" />

            <TextView
                android:id="@+id/tvAiTranslateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/overlay_ai_translate"
                android:textColor="@color/overlay_ai_pill_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 整句收藏 -->
        <ImageButton
            android:id="@+id/btnSaveSentence"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_nav_icon_button"
            android:contentDescription="@string/action_save_sentence"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bookmark_border"
            app:tint="@color/text_secondary"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_nav_icon_button"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/action_close" />
    </LinearLayout>

    <!-- 固定字幕主舞台卡片（Sticky Hero）：带左侧品牌竖向饰条，不随生词滚动而消失 -->
    <LinearLayout
        android:id="@+id/subtitleHeroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_overlay_card"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <View
            android:layout_width="3.5dp"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_subtitle_accent_bar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- 译文：第一视觉焦点 -->
            <TextView
                android:id="@+id/tvTranslatedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.Translation" />

            <!-- 原文：紧随译文下方 -->
            <TextView
                android:id="@+id/tvOriginalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>
    </LinearLayout>

    <!-- 重点词汇标题行（固定在滚动区上方）：标题 + 词数 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="2dp"
        android:paddingHorizontal="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/overlay_key_words"
            android:textAppearance="@style/TextAppearance.SubtitleTranslator.SectionLabel" />

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SubtitleTranslator.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      0dp + weight=1：窗口高度封顶后，滚动区只承载生词列表，
      顶部工具栏、字幕主卡片与底部操作栏始终固定可见。
    -->
    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/wordsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="4dp"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 底部操作栏（固定）：上一句 / 居中收起面板 / 下一句 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPreviousSubtitle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_nav_icon_button"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/overlay_previous_subtitle" />

        <LinearLayout
            android:id="@+id/btnCollapse"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_less"
                app:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/overlay_collapse_hint"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNextSubtitle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_nav_icon_button"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/text_secondary"
            android:contentDescription="@string/overlay_next_subtitle" />
    </LinearLayout>

</LinearLayout>
