<?xml version="1.0" encoding="utf-8"?><!--
  翻译结果覆盖层（竖屏 · 编辑纸感：无卡片、发丝分隔线 + 固定字幕块）

  核心设计：
  1. 字幕双语块固定在 ScrollView 之外（Sticky Hero）：往下滑看生词时，
     原句与译文始终留在顶部对照，不会滚丢；
  2. 不使用白卡片分层，靠字号层级与 1dp 发丝线组织内容；
  3. ScrollView 只承载「重点词汇」列表，按屏幕高度封顶时独立滚动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:orientation="vertical"
    android:background="@drawable/bg_translation_overlay"
    android:paddingStart="@dimen/overlay_padding_horizontal"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/overlay_padding_horizontal"
    android:paddingBottom="4dp">

    <!-- 顶部工具栏：左侧 AI 翻译纠错胶囊，右侧整句收藏 + 关闭（幽灵图标） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- AI 精译：纸感描边胶囊，请求中图标旋转，完成后高亮 -->
        <LinearLayout
            android:id="@+id/btnAiTranslate"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_ai_pill_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:contentDescription="@string/overlay_ai_translate">

            <ImageView
                android:id="@+id/ivAiTranslateIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ai_translate" />

            <TextView
                android:id="@+id/tvAiTranslateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/overlay_ai_translate"
                android:textColor="@color/overlay_ai_pill_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 整句收藏 -->
        <ImageButton
            android:id="@+id/btnSaveSentence"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginEnd="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_save_sentence"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bookmark_border"
            android:tint="@color/text_secondary"
            android:visibility="gone" />

        <!-- 关闭：用主文字色收尾，与其它操作区分层级 -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:tint="@color/text_primary"
            android:contentDescription="@string/action_close" />
    </LinearLayout>

    <!-- 固定字幕块（Sticky Hero）：无卡片，带左侧品牌竖饰条 -->
    <LinearLayout
        android:id="@+id/subtitleHeroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <View
            android:layout_width="2.5dp"
            android:layout_height="match_parent"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/bg_subtitle_accent_bar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <!-- 译文：第一视觉焦点 -->
            <TextView
                android:id="@+id/tvTranslatedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SubtitleTranslator.Translation" />

            <!-- 原文：紧随译文下方 -->
            <TextView
                android:id="@+id/tvOriginalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingMultiplier="1.35" />
        </LinearLayout>
    </LinearLayout>

    <!-- 字幕块与词表之间的发丝分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/overlay_divider" />

    <!-- 重点词汇标题行：标题 + 词数，与词条左内边距对齐 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp"
        android:paddingStart="@dimen/word_card_padding"
        android:paddingEnd="@dimen/word_card_padding"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/overlay_key_words"
            android:textAppearance="@style/TextAppearance.SubtitleTranslator.SectionLabel" />

        <TextView
            android:id="@+id/tvWordCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SubtitleTranslator.Caption"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      0dp + weight=1：窗口高度封顶后，滚动区只承载生词列表，
      顶部工具栏、字幕块与底部操作栏始终固定可见。
    -->
    <!-- 滚动区 + 底部渐隐：内容被视口截断时给出「还能滑」的视觉提示 -->
    <FrameLayout
        android:id="@+id/wordsScrollFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/contentScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/wordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/overlay_scroll_fade_height"
                android:orientation="vertical" />
        </ScrollView>

        <View
            android:id="@+id/scrollFade"
            android:layout_width="match_parent"
            android:layout_height="@dimen/overlay_scroll_fade_height"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scroll_fade"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <!-- 底部操作栏（固定）：上一句 / 居中收起 / 下一句，全部为幽灵图标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnPreviousSubtitle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_previous"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/overlay_previous_subtitle" />

        <LinearLayout
            android:id="@+id/btnCollapse"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_less"
                android:tint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/overlay_collapse_hint"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnNextSubtitle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_skip_next"
            android:tint="@color/text_secondary"
            android:contentDescription="@string/overlay_next_subtitle" />
    </LinearLayout>

</LinearLayout>
