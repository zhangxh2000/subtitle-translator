<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      固定使用深色主题（不再用 DayNight）

      所有界面都硬编码了「深色底 + 浅色字」的配色，若跟随系统切到浅色模式，
      Spinner 等由主题驱动颜色的控件会变成深色文字压在深色底上，几乎看不见，
      所以这里直接锁定深色，保证主题色与布局配色一致。
    -->
    <style name="Theme.SubtitleTranslator" parent="Theme.MaterialComponents.NoActionBar">
        <!-- 主色：设计 Token 里的强调色 -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dim</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dim</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <!--
          状态栏：targetSdk 35（Android 15）起系统强制 edge-to-edge，
          statusBarColor 在 API 35 上已失效、状态栏透明，露出的是界面自身的背景色。
          这里显式设置，让低版本系统上的观感保持一致。
          深色背景需要浅色状态栏图标。
        -->
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
    </style>
</resources>
