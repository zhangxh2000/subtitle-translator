<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      浅色模式设计 Token：暖白底色、清晰的中性色层级与高对比橄榄绿品牌色。
      夜间模式在 values-night/colors.xml 中保留原有深色调色板。
    -->
    <color name="screen_bg">#FFF6F7F2</color>
    <color name="panel_bg">#FFFFFFFF</color>
    <color name="card_bg">#FFFFFFFF</color>
    <color name="card_bg_pressed">#FFEFF2E7</color>
    <!-- 图标按钮的圆形底色（MD3 tonal icon button） -->
    <color name="surface_variant">#FFEDF0E7</color>

    <color name="text_primary">#FF1C2116</color>
    <color name="text_secondary">#FF60675B</color>
    <color name="text_meaning">#FF1C2116</color>
    <color name="divider">#FFE2E6DB</color>
    <color name="button_outline">#FFC8CEBF</color>

    <!-- 主界面：卡片描边、快捷入口底色、运行状态卡 -->
    <color name="card_stroke">#FFE4E8DE</color>
    <color name="surface_tile">#FFF0F3EA</color>
    <color name="status_bg">#FFEDF5DF</color>
    <color name="status_stroke">#FFC6D99B</color>

    <!-- 深橄榄绿在浅底上保持文字与图标对比度；按钮文字使用白色。 -->
    <color name="accent">#FF5E7D18</color>
    <color name="accent_dim">#FF49650F</color>
    <color name="on_accent">#FFFFFFFF</color>
    <!-- Material 3 primary container：用于 tonal 按钮/选中态 -->
    <color name="accent_container">#FFE6F1C8</color>
    <color name="on_accent_container">#FF35450C</color>
    <color name="day_tab_selected_text">#FF35450C</color>

    <!-- 服务运行中「停止」按钮的警示色 -->
    <color name="stop_button">#FFB3261E</color>

    <!-- 难度标签：低饱和底色 + 同色系文字 -->
    <color name="difficulty_hard_bg">#FFFCE8E6</color>
    <color name="difficulty_hard_text">#FFA32117</color>
    <color name="difficulty_medium_bg">#FFFFF3D6</color>
    <color name="difficulty_medium_text">#FF805700</color>
    <color name="difficulty_easy_bg">#FFE4F3E6</color>
    <color name="difficulty_easy_text">#FF276B36</color>
</resources>
