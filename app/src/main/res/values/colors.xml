<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      设计 Token（深色沉浸式）
      界面里一律引用这里的语义色，不要再直接写 @android:color/holo_* 或硬编码色值。
    -->
    <color name="screen_bg">#FF101114</color>
    <color name="panel_bg">#FF101114</color>
    <color name="card_bg">#FF24252B</color>
    <color name="card_bg_pressed">#FF2E3038</color>
    <!-- 图标按钮的圆形底色（MD3 tonal icon button） -->
    <color name="surface_variant">#FF2A2C33</color>

    <color name="text_primary">#FFF5F5F7</color>
    <color name="text_secondary">#FFA5A7B0</color>
    <color name="divider">#FF34353B</color>
    <color name="button_outline">#FF34353B</color>

    <color name="accent">#FFB9E64B</color>
    <!-- 大字号译文用低饱和版本，避免长时间观看刺眼 -->
    <color name="accent_dim">#FFCBE97F</color>
    <color name="on_accent">#FF101114</color>

    <!-- 服务运行中「停止」按钮的警示色 -->
    <color name="stop_button">#FFB3261E</color>

    <!-- 难度标签：低饱和底色 + 同色系文字 -->
    <color name="difficulty_hard_bg">#FF3A2326</color>
    <color name="difficulty_hard_text">#FFFF8A80</color>
    <color name="difficulty_medium_bg">#FF3A3320</color>
    <color name="difficulty_medium_text">#FFFFCC80</color>
    <color name="difficulty_easy_bg">#FF233A2A</color>
    <color name="difficulty_easy_text">#FFA5D6A7</color>
</resources>
