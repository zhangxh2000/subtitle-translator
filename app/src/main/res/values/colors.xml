    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    
    <!-- App specific colors -->
    <color name="primary">#FF6200EE</color>
    <color name="primary_dark">#FF3700B3</color>
    <color name="accent">#FF03DAC5</color>
    <color name="overlay_background">#CC000000</color>
    <color name="word_item_background">#F5F5F5</color>
    <!-- 服务运行中「停止」按钮的警示色 -->
    <color name="stop_button">#FFD32F2F</color>

    <!--
      深色界面下的文字与分隔线
      界面背景是纯黑，此前用的 @android:color/darker_gray (#444444) 对比度仅 2.6:1，
      远低于 WCAG AA 要求的 4.5:1，所以单独定义这两个颜色。
      次级文字在黑底上对比度约 9:1。
    -->
    <color name="text_secondary">#FFB3B3B3</color>
    <color name="divider">#33FFFFFF</color>
    <!-- 描边按钮的边框：默认描边是低透明度，纯黑背景上几乎看不见 -->
    <color name="button_outline">#66FFFFFF</color>
</resources>