    <!-- Help -->
    <string name="help_title">How to use</string>
    <string name="help_subtitle">From starting the floating assistant to reviewing words.</string>
    <string name="help_step_1_title">Start the assistant</string>
    <string name="help_step_1_desc">Tap “Start subtitle translation” on Home and allow screen capture and display over other apps.</string>
    <string name="help_step_2_title">Open a video</string>
    <string name="help_step_2_desc">Play a video in any player that shows subtitles on screen.</string>
    <string name="help_step_3_title">Tap the floating ball</string>
