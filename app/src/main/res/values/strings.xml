    <!-- OCR preprocessing modes -->
    <string name="preprocess_grayscale">Grayscale (recommended)</string>
    <string name="preprocess_adaptive">Adaptive threshold</string>
    <string name="preprocess_fixed">Fixed threshold</string>
    <string name="preprocess_grayscale_desc">Converts to grayscale without thresholding, preserving the brightness levels of the image. Use this when subtitles and background have similar colors.</string>
    <string name="preprocess_adaptive_desc">Uses a local threshold based on nearby brightness, which handles uneven lighting. May still fail when local contrast is very low.</string>
    <string name="preprocess_fixed_desc">Uses one threshold for the whole image. When subtitles and background have similar brightness, both may become the same color and the text disappears.</string>

