    <string name="settings_baidu_help">Register a developer account and create an app at fanyi-api.baidu.com. Your free quota is tied to your account; the key is stored only on this device.</string>
    <string name="settings_difficulty_filter">Vocabulary filter</string>
    <string name="settings_difficulty_help">Controls how many words appear under Key words. Loose shows more; Strict shows only difficult words. If you often see no words, try Loose.</string>
    <string name="settings_preprocess">OCR preprocessing</string>
    <string name="settings_debug_capture">Debug captures</string>
    <string name="settings_debug_capture_switch">Save recognition screenshots</string>
    <string name="settings_view_debug_captures">View recent captures</string>
    <string name="settings_debug_capture_help">When enabled, saves the original screenshot, cropped area, preprocessed image and OCR text of each recognition to help diagnose capture, crop, preprocessing or OCR issues. Keeps the latest 5 captures (about 6 MB) in app-private storage; never appears in your gallery.</string>
    <string name="settings_note">Note: language and vocabulary filter changes take effect the next time the translation service starts; the debug capture switch takes effect immediately.</string>
    <string name="settings_error_same_language">Source and target languages cannot be the same</string>

    <!-- Translation engines -->
    <string name="engine_mlkit">ML Kit offline (no setup)</string>
    <string name="engine_baidu">Baidu Translate (requires key)</string>
    <string name="engine_google">Google Translate (no key)</string>
    <string name="engine_hint_mlkit">Fully offline and needs no setup, but quality is modest and colloquial subtitles may be translated too literally.</string>
    <string name="engine_hint_baidu">Fast in mainland China and good quality. Enter your own APP ID and secret (free quota is per account).</string>
    <string name="engine_hint_google">No setup and good quality. May be unreachable in mainland China; falls back to the offline engine on failure.</string>

