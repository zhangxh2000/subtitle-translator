<?xml version="1.0" encoding="utf-8"?>
<!-- 运行状态指示点：外圈半透明 + 内圈实色，比纯色圆点更有呼吸感 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33B9E64B" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/accent" />
        </shape>
    </item>
</layer-list>
