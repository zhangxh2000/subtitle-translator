<?xml version="1.0" encoding="utf-8"?>
<!-- 浮窗次级操作圆形按钮：48dp 触摸区内的 36dp 纯白微描边圆形底色 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <inset android:inset="6dp">
            <shape android:shape="oval">
                <solid android:color="@color/overlay_control_bg" />
                <stroke
                    android:width="1dp"
                    android:color="@color/overlay_control_stroke" />
            </shape>
        </inset>
    </item>
</ripple>
