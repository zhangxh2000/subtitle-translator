<?xml version="1.0" encoding="utf-8"?>
<!-- 浅色主界面背景：微暖的白色渐变与柔和品牌色光晕。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#FFF8F9F5"
                android:endColor="#FFF2F4ED"
                android:startColor="#FFFAFBF8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0.02"
                android:endColor="#00A6C45A"
                android:gradientRadius="300dp"
                android:startColor="#1AA6C45A"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
